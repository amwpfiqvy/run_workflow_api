# Copy to /etc/run-workflow-api/watchdog.env; owner root, mode 600.
# Set a PAT with access to the target repository and Actions write permission.
GITHUB_TOKEN=
WATCHDOG_THRESHOLD=420
WATCHDOG_REF=main
# Optional HTTP proxy (do not assume the Windows proxy exists on Ubuntu).
# HTTPS_PROXY=http://127.0.0.1:7897
